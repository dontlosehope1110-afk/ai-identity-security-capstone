        <mxCell id="oV3DlRrxNqPps6v6KF6W-30" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Malicious Document Injection&lt;/h1&gt;&lt;p&gt;An attacker inserts malicious instructions into a document that enters the RAG knowledge base. When the agent retrieves the poisoned content, it may treat it as trusted context.&lt;/p&gt;" vertex="1">
          <mxGeometry height="170" width="230" x="-80" y="670" as="geometry" />
        </mxCell>
        <mxCell id="oV3DlRrxNqPps6v6KF6W-31" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;RAG Pipeline Compromise&lt;/h1&gt;&lt;p&gt;An attacker exploits weaknesses in the ingestion pipeline to modify or replace document chunks and store poisoned embeddings in the vector database.&lt;/p&gt;" vertex="1">
          <mxGeometry height="170" width="220" x="230" y="670" as="geometry" />
        </mxCell>
        <mxCell id="oV3DlRrxNqPps6v6KF6W-32" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Retrieval Manipulation&lt;/h1&gt;&lt;p&gt;An attacker crafts a query that causes the RAG system to retrieve poisoned chunks, influencing the agent&#39;s response or actions.&lt;/p&gt;" vertex="1">
